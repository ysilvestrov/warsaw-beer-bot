{
  "name": "warsaw-beer-extension",
  "private": true,
  "version": "0.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "python3 scripts/zip-dist.py",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "render-icons": "tsx scripts/render-icons.ts",
    "build:store": "CWS_BUILD=1 vite build",
    "package:store": "CWS_BUILD=1 vite build && CWS_BUILD=1 python3 scripts/zip-dist.py",
    "capture": "tsx scripts/capture-fixture.ts",
    "capture-omb-abv": "tsx scripts/capture-omb-abv-fixture.ts",
    "gen-flasker-breweries": "tsx scripts/gen-flasker-breweries.ts"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
