[Unit]
Description=merge-deploy: deploy origin/main when it is quiet, green and unheld
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ysi
Environment=HOME=/home/ysi
ExecStart=/usr/local/bin/wbb-autodeploy
# The image controller bounds its worst tick by TICK_BUDGET_S (7500 s, deploy/autodeploy.sh: every
# step under `timeout`, the window, the rollback loop); a oneshot's start timeout must never cut a
# tick short, so it is the budget plus a margin (owner's decision 6, spec amendment 3). A test reads
# both numbers.
TimeoutStartSec=125min
# 1 = refused, 2 = rolled back (code only) — both are reported to Telegram by the controller itself
# and are not systemd failures worth restarting. 3 = an incident opened or STATE CORRUPT, and
# 4 = the state could not be written, ARE failures.
SuccessExitStatus=0 1 2
StandardOutput=journal
StandardError=journal
