[Unit]
Description=merge-deploy: deploy origin/main when it is quiet, green and unheld
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ysi
Environment=HOME=/home/ysi
ExecStart=/usr/local/bin/wbb-autodeploy
# 125 min = TICK_BUDGET_S (7500 s) of deploy/autodeploy.sh: a oneshot's start timeout must never cut
# a tick short. The margin is inside the budget, not here: the worst tick the controller builds from
# its step timeouts (WORST_PATH_S, 7290 s) is checked to fit TICK_BUDGET_S (owner's decision 6, spec
# amendment 3). A test reads both numbers and requires them equal.
TimeoutStartSec=125min
# 1 = refused, 2 = rolled back (code only) — both are reported to Telegram by the controller itself
# and are not systemd failures worth restarting. 3 = an incident opened or STATE CORRUPT, and
# 4 = the state could not be written, ARE failures.
SuccessExitStatus=0 1 2
StandardOutput=journal
StandardError=journal
