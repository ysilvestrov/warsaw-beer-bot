{
  "language": "uk",
  "specFile": "spec.md",
  "specsDir": "docs/superpowers/specs",
  "plansDir": "docs/superpowers/plans",
  "gate": "npm test && npm run typecheck",
  "baseBranch": "origin/main",
  "tmpDir": "tmp",
  "reviewers": ["codex", "claude", "agy"],
  "models": { "codex": "gpt-6.1-sol", "agy": "gemini-4-argon" },
  "reviewContext": "One host, SQLite, a budget of $20–40/month, a single maintainer. Merged means deployed: the host deploys main after a merge, except a PR marked [deploy:hold]. Besides the detent block, CLAUDE.md holds this project's rules: read them, the Testing bullet above all. The platform: systemd, litestream, sqlite.",
  "prReview": {
    "include": [
      "src/**/*.ts",
      "src/api/**/*.html",
      "tests/**/*.ts",
      "scripts/**/*.ts",
      "scripts/**/*.py",
      "scripts/**/*.sh",
      "deploy/**/*.py",
      "deploy/**/*.sh",
      "deploy/**/*.cjs",
      "extension/**/*.ts",
      "extension/**/*.py",
      "extension/src/**/*.html",
      "extension/src/**/*.css",
      ".github/workflows/*.yml"
    ],
    "ignore": ["package-lock.json", "**/*.md", "docs/**"],
    "bodyExclude": [
      "**/*.test.ts",
      "tests/**/*.ts",
      "extension/tests/**/*.ts",
      "deploy/release/test_*.py",
      "deploy/release/release_testkit.py",
      "scripts/ops/test_*.py"
    ],
    "bodyInclude": ["scripts/ops/test_run.py"]
  }
}
