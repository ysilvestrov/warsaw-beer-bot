{
  // `tsconfig.json` includes only `src/**/*`, so nothing under `scripts/` had
  // ever been typechecked — a pipeline that runs on every PR was covered by
  // tests alone. This config closes that hole for the AI reviewer.
  //
  // Scoped to the reviewer rather than all of `scripts/` deliberately:
  // `bench-match.ts` carries four pre-existing type errors that are not this
  // change's to fix, and a check that is red on arrival is a check nobody runs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    // #435 — qualify.ts, manifest-scope.ts and qualify-cli.ts decide whether
    // production gets patched with nobody watching, so they are the last
    // place an untypechecked file belongs.
    "scripts/autodeploy/**/*",
    "scripts/ai-review/**/*",
    "scripts/ai-pr-review.ts",
    "scripts/ai-pr-review.test.ts",
    "scripts/cws-client.ts",
    "scripts/cws-client.test.ts",
    "scripts/cws-auth-bootstrap.ts",
    "scripts/cws-auth-bootstrap.test.ts",
    "scripts/publish-store-release.ts",
    "scripts/publish-store-release.test.ts"
  ]
}
